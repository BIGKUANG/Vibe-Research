# 用户私有层:配置 / 运行产物 / 知识层私有档案,永不入库
.local/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/

# 环境与密钥
.env
.env.*
!.env.example
*.key
*.pem

# 系统与日志
.DS_Store
*.log
logs/

# 前端构建缓存（Vite 依赖缓存 / tsc 增量编译信息）
.vite/
*.tsbuildinfo

# a-stock-data 参考工具包：只入库 SKILL.md 文档,其余(源码/示例/资产/.git.bak)一律不提交
# 注:嵌套 .git 已改名为 .git.bak,否则外层 git 会把它当子仓库(gitlink)导致 SKILL.md 无法入库
a-stock-data/*
!a-stock-data/SKILL.md
